#!/usr/bin/env bash
# Grow the root partition to fill the disk, then grow the filesystem.
set -euo pipefail

SYSFS_ROOT=${SYSFS_ROOT:-/sys}
SYSTEMD_GROWFS=${SYSTEMD_GROWFS:-/usr/lib/systemd/systemd-growfs}

dev=$(findmnt -vno SOURCE /sysroot)
partfile="$SYSFS_ROOT/class/block/$(basename "$dev")/partition"

if [ ! -r "$partfile" ]; then
  echo "growroot: $dev is not a plain partition; leaving it alone" >&2
  exit 0
fi

parent=$(lsblk -no PKNAME "$dev")
partnum=$(tr -d '[:space:]' < "$partfile")

# growpart exits 1 when there is nothing to grow.
rc=0
growpart "/dev/$parent" "$partnum" || rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
  echo "growroot: growpart failed with status $rc" >&2
  exit "$rc"
fi

mount -o remount,rw /sysroot
"$SYSTEMD_GROWFS" /sysroot
