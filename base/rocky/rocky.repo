[baseos]
name=Rocky Linux $releasever - BaseOS
baseurl=@MIRROR@/@EL@/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-@EL@

[appstream]
name=Rocky Linux $releasever - AppStream
baseurl=@MIRROR@/@EL@/AppStream/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-@EL@
